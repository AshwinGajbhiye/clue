# Clue Stealth Copilot — Environment Configuration

# ── AI API Keys ─────────────────────────────────────────────────────────────
# Google Gemini API key (recommended: gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter fallback (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── Stealth & Audio Rules Settings ──────────────────────────────────────────
# Default HUD Opacity: ghost (0.40), balanced (0.65), focus (0.85)
DEFAULT_OPACITY=balanced

# Audio Voice Activity Detection Settings
VAD_ENERGY_THRESHOLD=0.015
VAD_MIN_SPEECH_DURATION=1.2
VAD_SILENCE_TIMEOUT=1.4
VAD_MAX_UTTERANCE_DURATION=18.0

# Preferred default language for code solutions
PREFERRED_LANGUAGE=C++
